{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Flutter App",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": ["--flavor", "development"]
    },
    {
      "name": "Profile Flutter App",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "Release Flutter App",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "release"
    },
    {
      "name": "Debug Tests",
      "type": "dart",
      "request": "launch",
      "program": "test/",
      "args": ["--reporter", "expanded"]
    }
  ]
}
