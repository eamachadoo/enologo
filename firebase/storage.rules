rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can only upload/download their own images
    match /users/{userId}/wines/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Profile pictures
    match /users/{userId}/profile/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
